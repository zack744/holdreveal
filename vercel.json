{
  "rewrites": [
    { "source": "/en", "destination": "/index.html" },
    { "source": "/en/(.*)", "destination": "/index.html" },
    { "source": "/ko", "destination": "/index.html" },
    { "source": "/ko/(.*)", "destination": "/index.html" },
    { "source": "/zh", "destination": "/index.html" },
    { "source": "/zh/(.*)", "destination": "/index.html" },
    { "source": "/tr", "destination": "/index.html" },
    { "source": "/tr/(.*)", "destination": "/index.html" },
    { "source": "/how-it-works", "destination": "/index.html" },
    { "source": "/how-it-works/", "destination": "/index.html" },
    { "source": "/examples", "destination": "/index.html" },
    { "source": "/examples/", "destination": "/index.html" },
    { "source": "/tap-change", "destination": "/index.html" },
    { "source": "/tap-change/", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/faq/", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/privacy/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/examples/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
